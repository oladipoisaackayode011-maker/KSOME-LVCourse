rules_version = '2';

// ─────────────────────────────────────────────────────────────
// KSOME Firestore Security Rules
//
// IMPORTANT: These are not deployed automatically. Copy this file's
// contents into Firebase Console → Firestore Database → Rules, then
// click "Publish". Without rules like these, anyone with the website's
// public Firebase config (visible in the page source) could read or
// write every student's data directly, bypassing the admin panel.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == "oladipoisaac012@gmail.com";
    }

    function isOwner(email) {
      return request.auth != null && request.auth.token.email == email;
    }

    // Enrollment records — students can read only their own; anyone can
    // submit a new enrollment. Updates (e.g. the site's self-service
    // "Confirm Payment" step, or admin marking payment received) are left
    // open to match the current app design, since a student may update
    // their own record before ever logging in. Tighten this once a real
    // payment gateway/webhook replaces the self-reported "paid" flag.
    match /enrollments/{docId} {
      allow create: if true;
      allow read: if isAdmin() || isOwner(resource.data.email);
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Course notes/materials — any logged-in student can read (dashboard
    // filters by their enrolled course); only admin can upload/delete.
    match /course-materials/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Exams/tests — same as materials.
    match /exams-tests/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Exam/test results — a student may only read their own result rows.
    match /exam-results/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.email);
      allow write: if isAdmin();
    }

    // Certificates — a student may only read their own certificates.
    match /certificates/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.studentEmail);
      allow write: if isAdmin();
    }

    // Event booking requests — anyone can submit; only admin can view/manage.
    match /bookings/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
